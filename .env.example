SECRET_KEY=
DATABASE_URL=postgresql+psycopg://mnemio:mnemio@localhost:5433/mnemio

# --- Fontes externas de catálogo ---------------------------------------
# Sem as chaves o backend sobe normalmente: a busca do tipo correspondente
# devolve vazio (com aviso no log) em vez de quebrar.
# TMDB (filmes, séries e doramas): token v4 "API Read Access Token".
TMDB_API_READ_ACCESS_TOKEN=
# Google Books (livros): opcional na API, mas sem chave a quota é por IP.
GOOGLE_BOOKS_API_KEY=
# AniList (animes) não precisa de autenticação.

# --- Ajustes de busca e cache (todos opcionais) ------------------------
# MEDIA_SEARCH_TIMEOUT_SECONDS=2.5
# MEDIA_FETCH_TIMEOUT_SECONDS=3.0
# MEDIA_REFRESH_TIMEOUT_SECONDS=5.0
# MEDIA_CACHE_TTL_DAYS=30
# MEDIA_SEARCH_CACHE_TTL_SECONDS=60
# Países cujas séries do TMDB contam como dorama.
# DORAMA_ORIGIN_COUNTRIES=KR
